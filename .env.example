POSTGRES_USER=opencapper
POSTGRES_PASSWORD=<PASSWORD>
POSTGRES_HOST=opencapper-db
POSTGRES_DB=opencapper
DATABASE_URL=postgresql://opencapper:<PASSWORD>@localhost:5432/opencapper
ODDS_API_KEY=<THE_ODDS_API_KEY>
THESPORTSDB_API_KEY=123
BOT_API_TOKEN=<LONG_RANDOM_TOKEN>
# false stops the grading and closing line job
GRADING_ENABLED=true
# true imports picks from the Polymarket traders in src/server/importers/polymarket/traders.ts every 10 minutes
IMPORT_POLYMARKET_ENABLED=false
# with the Polymarket importer on: days of resolved pre start trades backfilled once at startup into history_picks (not the pick log); 0 disables
IMPORT_POLYMARKET_HISTORY_DAYS=90
# optional; local stub for the Polymarket gamma API (profile claims, markets), leave unset in production
POLYMARKET_GAMMA_BASE=
# Odds API credits the importers may spend per UTC day (2 per event odds call); 0 prices Polymarket picks by the fill and disables Reddit
IMPORT_ODDS_CREDITS_PER_DAY=0
# Odds API credits the web pick board may spend per UTC day on indicative moneylines (2 per sport refresh, one refresh per sport every 15 minutes at most); 0 lists events without prices
BOARD_ODDS_CREDITS_PER_DAY=20
# optional; Reddit script app for the r/sportsbook Pick of the Day importer, off unless all five are set
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=
DISCORD_CLIENT_ID=<DISCORD_OAUTH_CLIENT_ID>
DISCORD_CLIENT_SECRET=<DISCORD_OAUTH_CLIENT_SECRET>
# optional; redirect URI <site>/api/auth/callback/google, button hidden when unset
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# optional; login widget, the bot domain must be set in BotFather with /setdomain
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# at least 32 characters; rotating it logs everyone out
BETTER_AUTH_SECRET=<LONG_RANDOM_SECRET>
# comma separated Better Auth user ids (table "user", column id) that are always admin; other roles are set in /admin
ADMIN_USER_IDS=
NEXT_PUBLIC_SITE_URL=https://opencapper.coding-global.com
# Impressum identity, required: docker compose passes them as NEXT_PUBLIC_LEGAL_* build args and the image build fails when one is empty.
# Address lines are separated by a literal \n. Local `bun run build` reads NEXT_PUBLIC_LEGAL_* from the shell instead.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_VAT_ID=
LEGAL_EMAIL=
# optional; capper payments through Whop connected accounts, hidden unless key and secret are set.
# API key permissions: create child companies, update child company fees, company balance read, all payout
# permissions (read and update payout accounts, create, update, delete and read payout destinations, read and
# export transfers and withdrawals, withdraw funds, transfer funds), checkout configurations, plans, products.
# Never grant transfer_ownership. Webhook URL <site>/api/payments/webhooks/whop with connected account events on,
# events membership.activated, membership.deactivated, membership.updated, membership.cancel_at_period_end_changed, payment.succeeded.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# share of each sale OpenCapper keeps, in basis points (500 = 5%)
WHOP_PLATFORM_FEE_BPS=500
# graded picks a user needs before they may sell a plan
MIN_GRADED_PICKS_TO_SELL=30
LEADERBOARD_MIN_GRADED_PICKS=50
PROFILE_MIN_PICKS_FOR_ROI=20
# outline or filled
PROOF_MARKER_STYLE=outline
